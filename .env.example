# Supabase Postgres (get from Supabase Dashboard → Connect → Transaction pooler)
DATABASE_URL="postgresql://postgres:YOUR_PWD@db.YOUR_PROJECT.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_PWD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE"

# Admin Easter (badge ×5)
ADMIN_EASTER_ID="31"
ADMIN_EASTER_HASH="$2a$10$..." # bcrypt of ldldld, generate via `node -e "console.log(require('bcryptjs').hashSync('ldldld',10))"`

# Resend (free 100/j)
RESEND_API_KEY="re_xxx"
RESEND_FROM="HK Shipping <noreply@hkshipping.vercel.app>"

# Upstash Redis (for millions rate limit) - optional for now uses in-memory
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."
